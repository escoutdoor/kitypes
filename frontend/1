"use client"

import { useState } from "react"
import { useForm, Controller } from "react-hook-form"
import { zodResolver } from "@hookform/resolvers/zod"
import * as z from "zod"
import { PawPrint, Info, MapPin, Camera, Dog, Cat, Rabbit, Mars, Venus } from "lucide-react"

import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import { Field, FieldLabel, FieldError } from "@/components/ui/field"
import { Textarea } from "@/components/ui/textarea"

// 1. Схема валідації (Пофікшено TypeScript для чисел)
const createAdSchema = z.object({
    title: z.string().min(5, "Мінімум 5 символів").max(100, "Максимум 100 символів"),
    description: z.string().min(20, "Опишіть тваринку детальніше (мінімум 20 символів)"),

    petType: z.number({ required_error: "Оберіть тип тваринки" }).refine(val => [1, 2, 3].includes(val)),
    petGender: z.number({ required_error: "Оберіть стать" }).refine(val => [1, 2].includes(val)),

    // Магія Zod: якщо поле пусте (""), робимо його undefined, інакше - перетворюємо на число
    petAgeMonth: z.preprocess(
        (val) => (val === "" || val === undefined ? undefined : Number(val)),
        z.number().min(0, "Вік не може бути від'ємним").optional()
    ),

    petBreed: z.string().max(50).optional(),

    country: z.string().min(2, "Вкажіть країну"),
    city: z.string().min(2, "Вкажіть місто"),

    images: z.array(z.any()).min(1, "Додайте хоча б одну фотографію").max(10, "Максимум 10 фотографій"),
})

export type CreateAdFormValues = z.infer<typeof createAdSchema>

export default function CreateAdPage() {
    const [isSubmitting, setIsSubmitting] = useState(false)

    const {
        control,
        handleSubmit,
        formState: { errors },
    } = useForm<CreateAdFormValues>({
        resolver: zodResolver(createAdSchema),
        defaultValues: {
            title: "",
            description: "",
            petBreed: "",
            country: "Україна",
            city: "",
            images: [],
            // petAgeMonth, petType, petGender залишаємо без defaultValues, щоб вони були undefined
        },
    })

    const onSubmit = async (data: CreateAdFormValues) => {
        console.log("Form Data Submitted:", data)
        // Наступним кроком тут буде S3 логіка
    }

    return (
        <div className="max-w-3xl mx-auto py-8 animate-in fade-in duration-500">
            <div className="mb-10 text-center space-y-3">
                <div className="inline-flex items-center justify-center p-4 bg-primary/10 rounded-full mb-2">
                    <PawPrint className="h-8 w-8 text-primary" />
                </div>
                <h1 className="text-3xl font-extrabold tracking-tight text-gray-900">Знайти новий дім</h1>
                <p className="text-muted-foreground text-lg max-w-xl mx-auto">
                    Чим детальніше ви опишете хвостика та чим кращі фото додасте, тим швидше він знайде родину.
                </p>
            </div>

            <form onSubmit={handleSubmit(onSubmit)} className="space-y-8">

                {/* БЛОК 1: Фотографії */}
                <Card className="border-gray-200/60 shadow-sm overflow-hidden rounded-2xl">
                    <CardHeader className="border-b border-gray-100 bg-white pb-4">
                        <CardTitle className="flex items-center gap-2 text-xl">
                            <Camera className="h-5 w-5 text-primary" />
                            Фотографії
                        </CardTitle>
                        <CardDescription className="text-sm">
                            Додайте від 1 до 10 якісних фотографій. Перше фото буде головним.
                        </CardDescription>
                    </CardHeader>
                    <CardContent className="pt-6 bg-white">
                        <div className="h-40 border-2 border-dashed border-gray-300 rounded-xl flex items-center justify-center text-muted-foreground bg-gray-50/50">
                            (Тут буде наш Multi-Image Uploader)
                        </div>
                        {errors.images && (
                            <p className="text-sm font-medium text-destructive mt-2">
                                {errors.images.message?.toString()}
                            </p>
                        )}
                    </CardContent>
                </Card>

                {/* БЛОК 2: Основна інформація */}
                <Card className="border-gray-200/60 shadow-sm overflow-hidden rounded-2xl">
                    <CardHeader className="border-b border-gray-100 bg-white pb-4">
                        <CardTitle className="flex items-center gap-2 text-xl">
                            <Info className="h-5 w-5 text-primary" />
                            Про хвостика
                        </CardTitle>
                    </CardHeader>
                    <CardContent className="pt-6 bg-white space-y-8">

                        {/* ТИП ТВАРИНКИ */}
                        <Controller
                            name="petType"
                            control={control}
                            render={({ field, fieldState }) => (
                                <Field data-invalid={fieldState.invalid}>
                                    <FieldLabel className="text-base font-semibold text-gray-800">Кого ви віддаєте?</FieldLabel>
                                    <div className="grid grid-cols-3 gap-3 mt-2">
                                        {[
                                            { value: 1, label: "Песик", icon: Dog },
                                            { value: 2, label: "Котик", icon: Cat },
                                            { value: 3, label: "Інше", icon: Rabbit },
                                        ].map((type) => (
                                            <label
                                                key={type.value}
                                                className={`cursor-pointer flex items-center justify-center gap-2 p-3 rounded-xl border transition-all duration-200 ${field.value === type.value
                                                        ? "border-primary bg-primary/5 text-primary shadow-sm ring-1 ring-primary/20"
                                                        : "border-gray-200 hover:border-primary/40 text-gray-600 hover:bg-gray-50"
                                                    }`}
                                            >
                                                <input
                                                    type="radio"
                                                    className="hidden"
                                                    value={type.value}
                                                    checked={field.value === type.value}
                                                    onChange={() => field.onChange(type.value)}
                                                />
                                                <type.icon className="h-5 w-5" />
                                                <span className="font-semibold text-sm">{type.label}</span>
                                            </label>
                                        ))}
                                    </div>
                                    {fieldState.invalid && <FieldError errors={[fieldState.error]} />}
                                </Field>
                            )}
                        />

                        {/* СТАТЬ */}
                        <Controller
                            name="petGender"
                            control={control}
                            render={({ field, fieldState }) => (
                                <Field data-invalid={fieldState.invalid}>
                                    <FieldLabel className="text-base font-semibold text-gray-800">Стать</FieldLabel>
                                    <div className="grid grid-cols-2 gap-3 mt-2">
                                        <label
                                            className={`cursor-pointer flex items-center justify-center gap-2 p-3 rounded-xl border transition-all duration-200 ${field.value === 1
                                                    ? "border-blue-500 bg-blue-50 text-blue-700 shadow-sm ring-1 ring-blue-500/20"
                                                    : "border-gray-200 hover:border-blue-300 text-gray-600 hover:bg-gray-50"
                                                }`}
                                        >
                                            <input
                                                type="radio"
                                                className="hidden"
                                                value={1}
                                                checked={field.value === 1}
                                                onChange={() => field.onChange(1)}
                                            />
                                            <Mars className="h-5 w-5" />
                                            <span className="font-semibold text-sm">Хлопчик</span>
                                        </label>
                                        <label
                                            className={`cursor-pointer flex items-center justify-center gap-2 p-3 rounded-xl border transition-all duration-200 ${field.value === 2
                                                    ? "border-pink-500 bg-pink-50 text-pink-700 shadow-sm ring-1 ring-pink-500/20"
                                                    : "border-gray-200 hover:border-pink-300 text-gray-600 hover:bg-gray-50"
                                                }`}
                                        >
                                            <input
                                                type="radio"
                                                className="hidden"
                                                value={2}
                                                checked={field.value === 2}
                                                onChange={() => field.onChange(2)}
                                            />
                                            <Venus className="h-5 w-5" />
                                            <span className="font-semibold text-sm">Дівчинка</span>
                                        </label>
                                    </div>
                                    {fieldState.invalid && <FieldError errors={[fieldState.error]} />}
                                </Field>
                            )}
                        />

                        {/* ВІК ТА ПОРОДА */}
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                            <Controller
                                name="petBreed"
                                control={control}
                                render={({ field, fieldState }) => (
                                    <Field data-invalid={fieldState.invalid}>
                                        <FieldLabel className="text-base font-semibold text-gray-800">Порода <span className="text-gray-400 font-normal text-sm">(необов'язково)</span></FieldLabel>
                                        <Input placeholder="Напр., Мейн-кун або Дворняжка" className="bg-gray-50/50" {...field} />
                                        {fieldState.invalid && <FieldError errors={[fieldState.error]} />}
                                    </Field>
                                )}
                            />

                            <Controller
                                name="petAgeMonth"
                                control={control}
                                render={({ field, fieldState }) => (
                                    <Field data-invalid={fieldState.invalid}>
                                        <FieldLabel className="text-base font-semibold text-gray-800">Вік <span className="text-gray-400 font-normal text-sm">(у місяцях)</span></FieldLabel>
                                        <Input type="number" placeholder="Напр., 3" min="0" className="bg-gray-50/50" {...field} />
                                        {fieldState.invalid ? (
                                            <FieldError errors={[fieldState.error]} />
                                        ) : (
                                            <div className="text-[12px] text-muted-foreground mt-1.5">
                                                Залиште пустим, якщо вік невідомий. (1 рік = 12 міс.)
                                            </div>
                                        )}
                                    </Field>
                                )}
                            />
                        </div>

                        {/* НАЗВА ТА ОПИС */}
                        <div className="space-y-6 pt-6 border-t border-gray-100">
                            <Controller
                                name="title"
                                control={control}
                                render={({ field, fieldState }) => (
                                    <Field data-invalid={fieldState.invalid}>
                                        <FieldLabel className="text-base font-semibold text-gray-800">Короткий заголовок</FieldLabel>
                                        <Input placeholder="Рудий котик шукає сім'ю..." className="text-base bg-gray-50/50" {...field} />
                                        {fieldState.invalid && <FieldError errors={[fieldState.error]} />}
                                    </Field>
                                )}
                            />

                            <Controller
                                name="description"
                                control={control}
                                render={({ field, fieldState }) => (
                                    <Field data-invalid={fieldState.invalid}>
                                        <FieldLabel className="text-base font-semibold text-gray-800">Опис характеру та звичок</FieldLabel>
                                        <Textarea
                                            placeholder="Розкажіть про характер тваринки, чи привчена до лотка, як ставиться до інших тварин..."
                                            className="min-h-[140px] resize-y bg-gray-50/50 text-base"
                                            {...field}
                                        />
                                        {fieldState.invalid && <FieldError errors={[fieldState.error]} />}
                                    </Field>
                                )}
                            />
                        </div>
                    </CardContent>
                </Card>

                {/* БЛОК 3: Локація */}
                <Card className="border-gray-200/60 shadow-sm overflow-hidden rounded-2xl">
                    <CardHeader className="border-b border-gray-100 bg-white pb-4">
                        <CardTitle className="flex items-center gap-2 text-xl">
                            <MapPin className="h-5 w-5 text-primary" />
                            Місцезнаходження
                        </CardTitle>
                    </CardHeader>
                    <CardContent className="pt-6 bg-white grid grid-cols-1 md:grid-cols-2 gap-6">
                        <Controller
                            name="country"
                            control={control}
                            render={({ field, fieldState }) => (
                                <Field data-invalid={fieldState.invalid}>
                                    <FieldLabel className="text-base font-semibold text-gray-800">Країна</FieldLabel>
                                    <Input className="bg-gray-50/50" {...field} />
                                    {fieldState.invalid && <FieldError errors={[fieldState.error]} />}
                                </Field>
                            )}
                        />
                        <Controller
                            name="city"
                            control={control}
                            render={({ field, fieldState }) => (
                                <Field data-invalid={fieldState.invalid}>
                                    <FieldLabel className="text-base font-semibold text-gray-800">Місто</FieldLabel>
                                    <Input placeholder="Наприклад, Дніпро" className="bg-gray-50/50" {...field} />
                                    {fieldState.invalid && <FieldError errors={[fieldState.error]} />}
                                </Field>
                            )}
                        />
                    </CardContent>
                </Card>

                <div className="flex justify-end gap-4 pt-4 pb-12">
                    <Button variant="outline" type="button" onClick={() => window.history.back()} className="px-8">
                        Скасувати
                    </Button>
                    <Button type="submit" size="lg" disabled={isSubmitting} className="px-8 shadow-md hover:shadow-lg transition-shadow">
                        {isSubmitting ? "Публікація..." : "Опублікувати оголошення"}
                    </Button>
                </div>
            </form>
        </div>
    )
}
